# ============================================================
# KONFIGURASI AI CUSTOMER SERVICE SPMB (AISAH BOT)
# ============================================================

# Port Web Dashboard (untuk scan QR & tes chat di browser)
PORT=3000

# Nama Kampus / Institusi
CAMPUS_NAME="Universitas Al Amin"
BOT_NAME="Aisah (CS SPMB)"

# Pilihan Provider AI: 'auto' | 'gemini' | 'groq'
# 'auto' = Prioritas Gemini, jika limit/gagal otomatis beralih ke Groq
AI_PROVIDER=auto

# ------------------------------------------------------------
# 1. GOOGLE GEMINI API (Dapatkan gratis di https://aistudio.google.com/app/apikey)
# ------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------
# 2. GROQ API (Dapatkan gratis di https://console.groq.com/keys)
# ------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------
# PENGATURAN WHATSAPP
# ------------------------------------------------------------
# Aktifkan WhatsApp bot (true / false). Jika false, Anda tetap bisa tes di web dashboard
ENABLE_WHATSAPP=true

# Delay simulasi mengetik (ms) agar terlihat natural seperti CS manusia (misal: 1500 = 1.5 detik)
TYPING_DELAY_MS=1500

# Prefix untuk mengabaikan pesan grup (default true: hanya balas private chat)
REPLY_ONLY_PRIVATE_CHAT=true
